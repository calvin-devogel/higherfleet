[gd_resource type="Resource" script_class="ShipPartDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://data/scripts/ship/parts/ShipPartDefinition.cs" id="1_definition"]
[ext_resource type="Script" path="res://data/scripts/ship/parts/MountPortDefinition.cs" id="2_port"]
[ext_resource type="Script" path="res://data/scripts/ship/parts/StructuralCapability.cs" id="3_structural"]

[sub_resource type="RectangleShape2D" id="Footprint"]
size = Vector2(128, 128)

[sub_resource type="Resource" id="Structure"]
script = ExtResource("3_structural")
structural_strength = 0.0

[sub_resource type="Resource" id="PortNorth"]
script = ExtResource("2_port")
port_id = "north"
compatibility_class = "structural-half"
size = 1
local_position = Vector2(0, -64)
facing = 0

[sub_resource type="Resource" id="PortEast"]
script = ExtResource("2_port")
port_id = "east"
compatibility_class = "structural-half"
size = 1
local_position = Vector2(64, 0)
facing = 1

[sub_resource type="Resource" id="PortSouth"]
script = ExtResource("2_port")
port_id = "south"
compatibility_class = "structural-half"
size = 1
local_position = Vector2(0, 64)
facing = 2

[sub_resource type="Resource" id="PortWest"]
script = ExtResource("2_port")
port_id = "west"
compatibility_class = "structural-half"
size = 1
local_position = Vector2(-64, 0)
facing = 3

[resource]
script = ExtResource("1_definition")
part_id = "structural_hull_half"
display_name = "1×1 Hull"
description = "A 1×1 structural hull part that mounts to smaller structural ports."
tags = Array[String](["structural", "hull", "half-size"])
mass = 0.0
build_cost = 0.0
allowed_rotations_degrees = Array[int]([0, 90, 180, 270])
footprint = SubResource("Footprint")
mount_ports = Array[MountPortDefinition]([SubResource("PortNorth"), SubResource("PortEast"), SubResource("PortSouth"), SubResource("PortWest")])
capabilities = Array[PartCapability]([SubResource("Structure")])
